TUTORLINKNG_PRIMARY.ENV="local"

TUTORLINKNG_SERVER.PORT="8080"
TUTORLINKNG_SERVER.READ_TIMEOUT="30"
TUTORLINKNG_SERVER.WRITE_TIMEOUT="30"
TUTORLINKNG_SERVER.IDLE_TIMEOUT="60"
TUTORLINKNG_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

TUTORLINKNG_DATABASE.HOST="localhost"
TUTORLINKNG_DATABASE.PORT="5432"
TUTORLINKNG_DATABASE.USER="postgres"
TUTORLINKNG_DATABASE.PASSWORD=""
TUTORLINKNG_DATABASE.NAME="tutorlinkng"
TUTORLINKNG_DATABASE.SSL_MODE="disable"
TUTORLINKNG_DATABASE.MAX_OPEN_CONNS="25"
TUTORLINKNG_DATABASE.MAX_IDLE_CONNS="25"
TUTORLINKNG_DATABASE.CONN_MAX_LIFETIME="300"
TUTORLINKNG_DATABASE.CONN_MAX_IDLE_TIME="300"

TUTORLINKNG_AUTH.SECRET_KEY="secret"

TUTORLINKNG_INTEGRATION.RESEND_API_KEY="resend_key"

TUTORLINKNG_REDIS.ADDRESS="redis://localhost:6379"
TUTORLINKNG_REDIS.PASSWORD=

# ============================================================================
# AWS CONFIGURATION
# ============================================================================

TUTORLINKNG_AWS.REGION="apac"
TUTORLINKNG_AWS.ACCESS_KEY_ID=""
TUTORLINKNG_AWS.SECRET_ACCESS_KEY=""
TUTORLINKNG_AWS.UPLOAD_BUCKET="tutorlinkng-bucket"
TUTORLINKNG_AWS.ENDPOINT_URL=""


# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
TUTORLINKNG_OBSERVABILITY.SERVICE_NAME="tutorlinkng"
TUTORLINKNG_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
TUTORLINKNG_OBSERVABILITY.LOGGING.LEVEL="debug"
TUTORLINKNG_OBSERVABILITY.LOGGING.FORMAT="console"
TUTORLINKNG_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
TUTORLINKNG_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TUTORLINKNG_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
TUTORLINKNG_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
TUTORLINKNG_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
TUTORLINKNG_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
TUTORLINKNG_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
TUTORLINKNG_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
TUTORLINKNG_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"